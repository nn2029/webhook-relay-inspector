API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173

# Inbound provider signatures. Leave empty to accept unsigned local test events.
WEBHOOK_SIGNING_SECRET=change-me

# Optional HMAC used when this relay forwards events to downstream receivers.
RELAY_SIGNING_SECRET=relay-change-me

# In-memory retention is count-based for the MVP.
EVENT_RETENTION_LIMIT=1000
RULES_CONFIG_PATH=./config/forwarding-rules.example.json

# Future durable storage adapter.
POSTGRES_DSN=postgresql://webhook:relay@localhost:5432/webhook_relay

# Frontend dev server values.
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

